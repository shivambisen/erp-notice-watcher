[Unit]
Description=ERP watcher health check (fixes what it can, reports on WhatsApp)
After=network-online.target erp-wa-bridge.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/erp-notice-watcher
ExecStart=/home/ubuntu/erp-notice-watcher/venv/bin/python healthcheck.py
TimeoutStartSec=600
