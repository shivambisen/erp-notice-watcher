# Copy to .env (./setup.sh does this) and fill in the blanks.
# ./configure.sh asks for the secrets interactively so they never hit shell history.

# ---------------------------------------------------------------------------
# 1. ERP login  (required)
# ---------------------------------------------------------------------------
ERP_USER_ID=YOUR_ROLL_NUMBER
ERP_PASSWORD=
# The ERP asks ONE of your 3 security questions at random. Map a word from each
# question to its answer; the default is used when nothing matches.
ERP_SECURITY_ANSWER_DEFAULT=
ERP_SECURITY_ANSWERS=friend = answer1; language = answer2; pet = answer3

# ---------------------------------------------------------------------------
# 2. Mailbox the ERP sends the login OTP to  (required; read-only over IMAP)
#    Google app password: https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@kgpian.iitkgp.ac.in
IMAP_PASSWORD=
OTP_SENDER_HINT=erp

# ---------------------------------------------------------------------------
# 3. Database  (required for auto-apply and company alerts)
#    Free Postgres: https://neon.tech -> create project -> copy connection string
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# 4. Auto-apply
# ---------------------------------------------------------------------------
AUTO_APPLY=on
AUTO_APPLY_CV=2
AUTO_APPLY_MAX_ATTEMPTS=3
# Empty = every form type (PLACEMENT, INTERNSHIP, ...). Or e.g. PLACEMENT
COMPANY_ALERT_FORM_TYPES=
# Never apply to companies whose name contains any of these (comma separated)
COMPANY_ALERT_SKIP=
COMPANY_ALERT_MIN_CTC=0
COMPANY_REMINDER_HOURS=4

# ---------------------------------------------------------------------------
# 5. WhatsApp  (via the local bridge in wa-bridge/)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=bridge
WA_BRIDGE_URL=http://127.0.0.1:8766
# Group id (...@g.us) or phone number (+91...). Comma separated. The web UI
# (python serve.py -> Settings -> Find my groups) can fill this in for you.
WHATSAPP_TO=

# ---------------------------------------------------------------------------
# 6. Notice board
# ---------------------------------------------------------------------------
JQ_QUERY_ID=54
NOTICE_PAGE=Notice.jsp
NOTICE_ROWS=200
NOTICE_COLUMNS=ID,Type,Subject,Company,Notice,Ref,Notice Time,Download,Upload,Deactivate
NOTICE_TITLE_COL=3
NOTICE_TIME_COL=6
NOTICE_BODY_COL=4
NOTICE_HIDE_COLS=0,5,8,9
NOTICE_TYPE_COL=1
# Notice types that are stored but never sent, e.g. INTERNSHIP
NOTICE_EXCLUDE_TYPES=
SEED_SILENTLY=1

# ---------------------------------------------------------------------------
# 7. Email alerts  (optional; off = WhatsApp only)
# ---------------------------------------------------------------------------
MAIL_ENABLED=off
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_TO=
